<Application x:Class="FileHashGeneratorAndValidator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileHashGeneratorAndValidator"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:FileHashGeneratorAndValidator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpfui:ThemesDictionary Theme="Dark"/>
                <wpfui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <Style x:Key="PrimaryButton" TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Background" Value="DarkBlue"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
